{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": false,
    "jsx": "react",
    "allowJs": false,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@nocobase/*": ["../../*/src"]
    },
    "outDir": "dist/server-build"
  },
  "include": ["src/server/**/*.ts"]
}
