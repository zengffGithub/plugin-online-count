{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react",
    "allowJs": false,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@nocobase/*": ["../../*/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
